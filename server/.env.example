NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webcrm?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/webcrm?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-64-random-chars-access
JWT_REFRESH_SECRET=change-me-64-random-chars-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Supabase Storage
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=media
STORAGE_PUBLIC_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/media

# Razorpay (org payment defaults; per-org settings override)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DONATION_MAX_AMOUNT=1000000

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
